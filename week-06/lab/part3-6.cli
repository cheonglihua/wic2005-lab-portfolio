sh sleep 1
sh echo 'mininet> h1 ping -c 1 10.3.100.2'
h1 ping -c 1 10.3.100.2
sh echo 'mininet> sh sleep 4; cat /tmp/h2.txt'
sh sleep 4; cat /tmp/h2.txt
