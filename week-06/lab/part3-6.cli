sh echo '===== Part 3: VXLAN by hand'
sh echo 'mininet> h1 ip link add vxlan100 type vxlan id 100 local 10.3.0.1 remote 10.3.0.2 dstport 4789 dev h1-eth0'
h1 ip link add vxlan100 type vxlan id 100 local 10.3.0.1 remote 10.3.0.2 dstport 4789 dev h1-eth0
sh echo 'mininet> h1 ip addr add 10.3.100.1/24 dev vxlan100'
h1 ip addr add 10.3.100.1/24 dev vxlan100
sh echo 'mininet> h1 ip link set vxlan100 up'
h1 ip link set vxlan100 up
sh echo 'mininet> h2 ip link add vxlan100 type vxlan id 100 local 10.3.0.2 remote 10.3.0.1 dstport 4789 dev h2-eth0'
h2 ip link add vxlan100 type vxlan id 100 local 10.3.0.2 remote 10.3.0.1 dstport 4789 dev h2-eth0
