h1 ping -c 2 10.3.100.2
sh echo 'mininet> h2 timeout 4 tcpdump -ni h2-eth0 udp port 4789 > /tmp/h2.txt 2>&1 &'
h2 timeout 4 tcpdump -ni h2-eth0 udp port 4789 > /tmp/h2.txt 2>&1 &
