# Part 3: VXLAN by hand
h1 ip link add vxlan100 type vxlan id 100 local 10.3.0.1 remote 10.3.0.2 dstport 4789 dev h1-eth0
h1 ip addr add 10.3.100.1/24 dev vxlan100
h1 ip link set vxlan100 up
h2 ip link add vxlan100 type vxlan id 100 local 10.3.0.2 remote 10.3.0.1 dstport 4789 dev h2-eth0
h2 ip addr add 10.3.100.2/24 dev vxlan100
h2 ip link set vxlan100 up
h1 ping -c 2 10.3.100.2
h2 timeout 4 tcpdump -ni h2-eth0 udp port 4789 > /tmp/h2.txt 2>&1 &
sh sleep 1
h1 ping -c 1 10.3.100.2
sh sleep 4; cat /tmp/h2.txt
# Part 4: MTU and throughput
h1 ip link show h1-eth0
h1 ip link show vxlan100
h1 ping -M do -c 1 -s 1422 10.3.100.2
h1 ping -M do -c 1 -s 1423 10.3.100.2
h2 iperf3 -s -D
sh sleep 1
h1 iperf3 -c 10.3.0.2 -t 5
h1 iperf3 -c 10.3.100.2 -t 5
# Part 5: IPv6 underlay
h1 ip -6 addr add fd00:4903::1/64 dev h1-eth0
h2 ip -6 addr add fd00:4903::2/64 dev h2-eth0
sh sleep 2
h1 ping -6 -c 2 fd00:4903::2
h1 ip link add vxlan106 type vxlan id 106 local fd00:4903::1 remote fd00:4903::2 dstport 4789 dev h1-eth0
h1 ip addr add 10.3.106.1/24 dev vxlan106
h1 ip link set vxlan106 up
h2 ip link add vxlan106 type vxlan id 106 local fd00:4903::2 remote fd00:4903::1 dstport 4789 dev h2-eth0
h2 ip addr add 10.3.106.2/24 dev vxlan106
h2 ip link set vxlan106 up
h1 ping -c 2 10.3.106.2
h1 ip link show vxlan106
h1 ping -M do -c 1 -s 1402 10.3.106.2
h1 ping -M do -c 1 -s 1403 10.3.106.2
h2 timeout 4 tcpdump -ni h2-eth0 udp port 4789 > /tmp/h2v6.txt 2>&1 &
sh sleep 1
h1 ping -c 1 10.3.106.2
sh sleep 4; cat /tmp/h2v6.txt
# Part 6: MTU mismatch
h2 ip link set h2-eth0 mtu 1400
h1 ping -c 2 10.3.100.2
h1 ping -c 2 -W 1 -s 1400 10.3.100.2
h1 timeout 20 iperf3 -c 10.3.100.2 -t 5
h1 ping -M do -c 1 -W 1 -s 1300 10.3.100.2
h1 ping -M do -c 1 -W 1 -s 1322 10.3.100.2
h1 ping -M do -c 1 -W 1 -s 1326 10.3.100.2
h1 ping -M do -c 1 -W 1 -s 1327 10.3.100.2
sh cat /sys/class/net/s1-eth2/statistics/tx_dropped
h2 cat /sys/class/net/h2-eth0/statistics/rx_dropped
h1 ping -c 3 -W 1 -s 1400 10.3.100.2
sh cat /sys/class/net/s1-eth2/statistics/tx_dropped
h2 cat /sys/class/net/h2-eth0/statistics/rx_dropped
h1 ip link set vxlan100 mtu 1500
h2 ip link set h2-eth0 mtu 1500
h1 ping -c 2 -s 1400 10.3.100.2
h1 iperf3 -c 10.3.100.2 -t 5
