sh echo "== shop (VNI 4901): every VM to every other" > evidence6/connectivity.txt
web1 ping -c 1 -W 1 10.3.50.11 >> evidence6/connectivity.txt
web1 ping -c 1 -W 1 10.3.50.12 >> evidence6/connectivity.txt
web2 ping -c 1 -W 1 10.3.50.10 >> evidence6/connectivity.txt
web2 ping -c 1 -W 1 10.3.50.12 >> evidence6/connectivity.txt
web3 ping -c 1 -W 1 10.3.50.10 >> evidence6/connectivity.txt
web3 ping -c 1 -W 1 10.3.50.11 >> evidence6/connectivity.txt
sh echo "== bank (VNI 4902)" >> evidence6/connectivity.txt
pay1 ping -c 1 -W 1 10.3.50.11 >> evidence6/connectivity.txt
pay2 ping -c 1 -W 1 10.3.50.10 >> evidence6/connectivity.txt
sh echo "== lab (VNI 4903)" >> evidence6/connectivity.txt
dev1 ping -c 1 -W 1 10.3.70.11 >> evidence6/connectivity.txt
dev2 ping -c 1 -W 1 10.3.70.10 >> evidence6/connectivity.txt
sh echo "== and no other: pay1 to 10.3.50.12 (web3's address, not in bank) must fail" >> evidence6/connectivity.txt
pay1 ping -c 2 -W 1 10.3.50.12 >> evidence6/connectivity.txt
sh echo "== and no other: web1 to 10.3.70.10 (dev1, another tenant's network) must fail" >> evidence6/connectivity.txt
web1 ping -c 1 -W 1 10.3.70.10 >> evidence6/connectivity.txt 2>&1
